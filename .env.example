# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeband?retryWrites=true&w=majority

# ─── Security ─────────────────────────────────────────────────────────────────
# HMAC secret used to hash email addresses before storage (use a long random string)
HASH_SECRET=change_me_to_a_long_random_secret

# JWT signing secret
JWT_SECRET=change_me_to_another_long_random_secret

# JWT expiry (e.g. 7d, 24h, 30m)
JWT_EXPIRY=7d

# ─── OTP ──────────────────────────────────────────────────────────────────────
# How many minutes before an OTP expires
OTP_TTL_MINUTES=5

# Maximum failed attempts before an OTP session is invalidated
MAX_OTP_ATTEMPTS=5

# ─── Email — Nodemailer ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email_address
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@lifeband.in

# Set to "true" to send real emails — any other value uses console logging (safe for dev/CI)
EMAIL_ENABLED=false

# ─── Band Generation ───────────────────────────────────────────────────────────
# Base URL baked into QR codes — permanent, never change after printing
QR_BASE_URL=https://lifeband.in/i

# Maximum bands per single admin generation batch
MAX_BANDS_PER_BATCH=500

# Permanent ZIP storage directory (absolute path or relative to project root)
# ZIPs are never deleted so manufacturers can re-download at any time
STORAGE_DIR=./storage/series
